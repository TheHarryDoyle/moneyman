# MoneyMan environment example.
# Copy to .env for local use if future tooling supports loading it.
# Do not put real API secrets in this example file.

# Top-level location for raw, derived, catalog, quarantine, and report folders.
MONEYMAN_DATA_ROOT=D:\MoneyManData

# Raw immutable Coinbase WebSocket captures.
MONEYMAN_RAW_ROOT=D:\MoneyManData\raw

# Rebuildable normalized tables, features, backtests, and reports.
MONEYMAN_DERIVED_ROOT=D:\MoneyManData\derived

# Rebuildable file/session manifests and inventory outputs.
MONEYMAN_CATALOG_ROOT=D:\MoneyManData\catalog

# Malformed, unknown, or rejected records for later inspection.
MONEYMAN_QUARANTINE_ROOT=D:\MoneyManData\quarantine

# Default public products for collection and research.
MONEYMAN_PRODUCTS=XRP-USD,BTC-USD,ETH-USD

# Default Coinbase public WebSocket URL used by the prototype logger.
MONEYMAN_COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# Optional path to the Codex Word Game / Codex Study Hub repo.
# Any future MoneyMan web GUI should integrate there instead of opening another visible port.
CODEX_STUDY_HUB_ROOT=C:\Path\To\CodexWordGame
CODEX_STUDY_HUB_PORT=8000

# Future authenticated Coinbase variables belong in a private .env only.
# Do not commit real Coinbase keys.
COINBASE_API_KEY=
COINBASE_API_KEY_NAME=
COINBASE_API_SECRET=
COINBASE_API_PRIVATE_KEY=

# Example configurable Coinbase One Advanced spot-fee rebate research scenario.
# Override these if Coinbase changes the benefit or if part of the monthly cap is already used.
MONEYMAN_COINBASE_ONE_ADVANCED_REBATE_RATE=0.25
MONEYMAN_COINBASE_ONE_ADVANCED_REBATE_CAP_USDC=100
MONEYMAN_COINBASE_ONE_ADVANCED_REBATE_USED_USDC=0

# Fallback-candle gridbot fills are modeled as limit-order maker fills by default.
# Use taker for conservative tests.
MONEYMAN_GRIDBOT_LIQUIDITY_ASSUMPTION=maker
